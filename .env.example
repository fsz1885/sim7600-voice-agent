LLM_PROVIDER=mock
# Required only when LLM_PROVIDER=anthropic. Never commit the actual .env file.
ANTHROPIC_API_KEY=
KIMI_API_KEY=
# Kimi Code subscription keys use https://api.kimi.com/coding/v1 and kimi-for-coding.
KIMI_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Local console uses Ollama by default and does not load this file automatically.
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_CONTEXT=8192
# Voice console selection is separate from the original CLI LLM_PROVIDER.
VOICE_LLM_PROVIDER=ollama
# Set compatible for a local or LAN llama.cpp server (restart required).
# VOICE_LLM_PROVIDER=compatible
# LLM_BASE_URL=http://10.3.71.235:8080/v1
# LLM_MODEL=sim7600-local
# LLM_API_KEY_FILE=local-data/3070-api-key.txt
