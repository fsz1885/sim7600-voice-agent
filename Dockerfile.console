FROM node:22-bookworm-slim AS browser
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY scripts/vendor-vad.cjs scripts/vendor-vad.cjs
COPY scripts/licenses scripts/licenses
RUN node scripts/vendor-vad.cjs

FROM python:3.12-slim
WORKDIR /app
COPY requirements-local.lock ./
RUN pip install --no-cache-dir -r requirements-local.lock
COPY pyproject.toml README.md ./
COPY src ./src
COPY --from=browser /build/src/voice_agent/static/vendor ./src/voice_agent/static/vendor
RUN pip install --no-deps --no-build-isolation . && useradd --uid 10001 --create-home agent
USER agent
EXPOSE 8765
ENTRYPOINT ["voice-console", "--host", "0.0.0.0"]
